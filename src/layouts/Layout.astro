---
// src/layouts/Layout.astro
import '../styles/global.css';

import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';

import monLogo from '../Images/bcb.svg';

interface Props {
  title: string;
  backHref?: string;
}
const { title, backHref } = Astro.props;
---
<!doctype html>
<html lang="fr" class="bg-black text-white overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/bcb.svg" />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased site-shell">
    <div class="cursor-fx" aria-hidden="true"><span></span></div>

    <nav class="fixed top-0 w-full z-50 p-6 flex justify-between mix-blend-difference text-white" aria-label="Navigation principale">
      <div class="flex flex-col">
        <a href="/" class="flex items-center nav-link">
          <Image src={monLogo} alt="Logo Portfolio Batiste" class="h-8 w-auto object-contain" />
        </a>
        {backHref && (
          <a href={backHref} class="nav-link flex items-center gap-1.5 mt-2 text-xs font-mono opacity-70 hover:opacity-100 transition-opacity group">
            <svg class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Retour aux projets
          </a>
        )}
      </div>

      <div class="flex gap-6 text-sm font-medium">
        <a href="/" class="nav-link hover:text-gray-400 transition-colors">Accueil</a>
        <a href="/projets" class="nav-link hover:text-gray-400 transition-colors">Projets</a>
        <a href="/cv" class="nav-link hover:text-gray-400 transition-colors">CV</a>
      </div>
    </nav>

    <slot />
    <Analytics />

    <script is:inline>
      const initCursor = () => {
        const cursor = document.querySelector('.cursor-fx');
        const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;

        if (!cursor || isCoarsePointer) {
          if (cursor) cursor.style.display = 'none';
          return;
        }

        const position = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
        cursor.style.transform = `translate(${position.x}px, ${position.y}px)`;

        document.addEventListener('pointermove', (event) => {
          position.x = event.clientX;
          position.y = event.clientY;
          cursor.style.transform = `translate(${position.x}px, ${position.y}px)`;
        }, { passive: true });

        document.querySelectorAll('.nav-link, a, button, .project-card').forEach((element) => {
          element.addEventListener('pointerenter', () => cursor.classList.add('is-active'));
          element.addEventListener('pointerleave', () => cursor.classList.remove('is-active'));
        });
      };

      const initReveal = () => {
        const reveals = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });

        reveals.forEach((element) => observer.observe(element));
      };

      document.addEventListener('astro:page-load', () => {
        initCursor();
        initReveal();
      });

      initCursor();
      initReveal();
    </script>
  </body>
</html>
