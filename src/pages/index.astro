---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio | Ingénierie Image & VR">
  
  <!-- Hero Section -->
  <section class="h-screen flex flex-col items-center justify-center">
    <h1 class="text-5xl md:text-7xl font-light tracking-tight text-center">
      Ingénierie <br/> 
      <span class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-gray-300 to-gray-600">
        Image & Multimédia.
      </span>
    </h1>
    <p class="mt-8 text-gray-500 animate-pulse">Scrollez pour explorer</p>
  </section>

  <!-- Section Scrollytelling (La Piste) -->
  <section class="relative h-[300vh]" id="scroll-section">
    
    <!-- La Caméra (Le bloc Sticky) -->
    <div class="sticky top-0 h-screen flex items-center overflow-hidden bg-zinc-950">
      
      <!-- Grille de mise en page : 2 colonnes -->
      <div class="w-full max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        
        <!-- COLONNE GAUCHE : Textes -->
        <div class="relative h-64">
          <!-- Projet 1 -->
          <div class="absolute inset-0 flex flex-col justify-center" id="text-1">
            <h2 class="text-4xl md:text-5xl font-bold">Visualisation<br/>Comportementale VR</h2>
            <p class="text-xl text-gray-400 mt-4">Analyse eye-tracking 3D immersive sur modèles architecturaux (Temple de Mars).</p>
          </div>
          
          <!-- Projet 2 -->
          <div class="absolute inset-0 flex flex-col justify-center opacity-0 translate-y-10" id="text-2">
            <h2 class="text-4xl md:text-5xl font-bold">Cartographie<br/>Interactive Mobile</h2>
            <p class="text-xl text-gray-400 mt-4">Intégration d'un globe 3D MapLibre et base de données spatiale pour l'exploration.</p>
          </div>
        </div>

        <!-- COLONNE DROITE : Médias -->
        <div class="relative h-96">
          <!-- Média 1 -->
          <div class="absolute inset-0 bg-zinc-900 rounded-xl border border-zinc-800 flex items-center justify-center shadow-2xl" id="media-1">
            <span class="text-zinc-600 font-mono">[Vidéo Capture Meta Quest 3]</span>
          </div>
          
          <!-- Média 2 -->
          <div class="absolute inset-0 bg-zinc-900 rounded-xl border border-zinc-800 flex items-center justify-center shadow-2xl opacity-0 scale-95" id="media-2">
            <span class="text-zinc-600 font-mono">[Démo App Android]</span>
          </div>
        </div>
        
      </div>
    </div>
  </section>
  
  <!-- Footer basique -->
  <section class="h-[50vh] flex items-center justify-center border-t border-zinc-900">
    <p class="text-gray-500">Contact et CV à venir...</p>
  </section>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // La chronologie d'animation
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#scroll-section", 
      start: "top top",
      end: "bottom bottom",
      scrub: 1, // Le "1" ajoute un léger lissage (smooth) au scroll
    }
  });

  // Étape 1 : On fait disparaître le Projet 1 (Texte vers le haut, Média rétrécit)
  tl.to("#text-1", { opacity: 0, y: -50, duration: 1 })
    .to("#media-1", { opacity: 0, scale: 0.95, duration: 1 }, "<"); 
    // Le symbole "<" dit à GSAP : "Joue cette animation en même temps que la précédente"

  // Étape 2 : On fait apparaître le Projet 2 (Texte monte, Média grandit)
  tl.to("#text-2", { opacity: 1, y: 0, duration: 1 })
    .to("#media-2", { opacity: 1, scale: 1, duration: 1 }, "<");
</script> 