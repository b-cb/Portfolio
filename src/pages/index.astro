---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import CalibrationGrid from '../components/CalibrationGrid.astro';
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';

const academiques = projects.filter(p => p.group === 'academique');
const persos = projects.filter(p => p.group === 'perso');
const total = projects.length;
const countAca = academiques.length;
const countPerso = persos.length;

const skillCategories = [
  { name: 'XR & Vision', skills: ['Unity', 'OpenXR', 'OpenCV', 'YOLO', 'Eye-tracking'] },
  { name: 'Core & System', skills: ['C++', 'C#', 'Python', 'Linux Native', 'Java', 'Kotlin'] },
  { name: 'Web & Tools', skills: ['Astro', 'Tailwind CSS', 'Git', 'Spring Boot', 'MATLAB', 'Blender'] },
];

---

<Layout title="Batiste COMET-BARTHE | Portfolio">
  <section class="h-screen flex flex-col items-center justify-center relative overflow-hidden hero-shell" id="hero-section" aria-label="Hero portfolio">
    <CalibrationGrid />

    <div class="text-center px-4 will-change-transform z-10 relative" id="hero-content">
      <div class="hero-status inline-flex items-center gap-2 mb-8 px-4 py-2 text-xs font-mono tracking-widest uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
        Disponible — Stage terminé · IRISA / Inria
      </div>

      <h1 class="text-5xl md:text-7xl lg:text-8xl font-light tracking-tight text-white leading-[1.05]">
        Ingénieur<br/>
        <span class="font-semibold text-[var(--accent)]">
          Image &amp; Multimédia
        </span>
      </h1>

      <p class="mt-6 text-zinc-400 text-base font-light max-w-md mx-auto leading-relaxed">
        VR · Computer Graphics · C++ · Linux Native
      </p>

      <!-- CTA scrolldown -->
      <div class="mt-14 flex flex-col items-center gap-3">
        <a href="#a-propos" class="group flex flex-col items-center gap-2 text-zinc-500 hover:text-zinc-300 transition-colors duration-300 cursor-pointer">
          <span class="text-xs font-mono uppercase tracking-[0.3em]">Découvrir</span>
          <svg class="w-4 h-4 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION : PRÉSENTATION PERSONNELLE & ACADÉMIQUE -->
  <section class="min-h-screen py-32 px-6 flex flex-col justify-center will-change-transform" id="a-propos">
    <div class="max-w-6xl mx-auto w-full" id="about-content">
      
      <!-- En-tête de section -->
      <div class="mb-16 flex flex-col items-center text-center">
        <span class="text-xs font-mono uppercase tracking-widest mb-3 text-zinc-500">À propos</span>
        <h2 class="text-3xl md:text-5xl font-medium tracking-tight">Profil &amp; Parcours</h2>
      </div>

      <!-- 1. PARTIE HAUTE : Profil & Vision (Centré) -->
      <div class="max-w-3xl mx-auto text-center space-y-8 mb-24">
        <p class="text-zinc-400 leading-relaxed text-lg font-light">
          Élève-ingénieur passionné par le traitement d'image, la réalité virtuelle et le rendu temps réel. Mon approche combine rigueur algorithmique bas niveau (C++, Python) et conception d'expériences interactives immersives sous Linux et casques autonomes.
        </p>
        <p class="text-zinc-400 leading-relaxed text-lg font-light">
          Au-delà du code, je cultive une approche pluridisciplinaire alliant persévérance sportive (sports d'endurance, tennis), création multimédia et gestion de projets associatifs.
        </p>

        <!-- Puces de compétences centrées -->
        <div class="pt-4 flex flex-wrap justify-center gap-3">
          <span class="about-skill">VR / XR</span>
          <span class="about-skill">Computer Graphics</span>
          <span class="about-skill">Linux Native</span>
          <span class="about-skill">Anglais C1</span>
        </div>
      </div>

      <!-- 2. PARTIE BASSE : Frise Chronologique -->
      <div class="w-full mt-12">

        <!-- A. Version BUREAU (Horizontale fidèle au croquis) -->
        <div class="hidden md:block relative w-full mt-10 h-64 timeline">
          
          <!-- Ligne de fond globale -->
          <div class="absolute top-1/2 left-0 w-full h-px bg-zinc-800/80"></div>
          
          <!-- Segments de ligne colorés -->
          <!-- Prépa (environ 35% de la durée) -->
          <div class="absolute top-1/2 -translate-y-[0.5px] left-0 w-[35%] h-[2px] timeline-line timeline-line--prepa"></div>
          <!-- ENSEEIHT (environ 65% de la durée) -->
          <div class="absolute top-1/2 -translate-y-[0.5px] left-[35%] w-[65%] h-[2px] timeline-line timeline-line--enseeiht"></div>
          
          <!-- Séparateur vertical discret -->
          <div class="absolute top-1/2 left-[35%] h-8 w-px bg-zinc-600 -translate-y-1/2"></div>

          <!-- Étape 1 : CPGE (Au-dessus, à gauche) -->
          <div class="absolute top-0 left-0 w-[35%] h-1/2 flex flex-col justify-end pb-6 pl-4 group cursor-default timeline-step timeline-step--prepa">
            <div class="border-l border-transparent group-hover:border-zinc-500 transition-colors pl-2">
              <span class="text-xs font-mono text-zinc-400 tracking-widest">2022 — 2024</span>
              <h4 class="text-lg font-medium text-zinc-200 mt-2">CPGE (PT*)</h4>
              <p class="text-sm text-zinc-500 mt-1 font-light">Lycée Déodat de Séverac</p>
            </div>
          </div>

          <!-- Étape 2 : ENSEEIHT (Au-dessus, à droite) -->
          <div class="absolute top-0 left-[35%] w-[65%] h-1/2 flex flex-col justify-end pb-6 pl-8 group cursor-default timeline-step timeline-step--enseeiht">
            <div class="border-l border-transparent group-hover:border-zinc-500 transition-colors pl-2">
              <span class="text-xs font-mono text-zinc-400 tracking-widest">2024 — 2027</span>
              <h4 class="text-lg font-medium text-zinc-200 mt-2">Ingénierie Image &amp; Multimédia</h4>
              <p class="text-sm text-zinc-500 mt-1 font-light">ENSEEIHT (Toulouse INP)</p>
            </div>
          </div>

          <!-- Étape 3 : Stage (En-dessous, accroché à la ligne ENSEEIHT) -->
          <div class="absolute top-1/2 left-[70%] w-[30%] h-1/2 flex flex-col justify-start pt-6 pl-0 group cursor-default timeline-step timeline-step--stage">
            <!-- Le point sur la ligne -->
            <div class="absolute top-0 left-0 w-3 h-3 bg-zinc-400 rounded-full -translate-y-[6px] -translate-x-[6px] ring-4 ring-black group-hover:scale-110 transition-transform z-10"></div>
            <!-- Petit trait de liaison vertical vers le texte -->
            <div class="absolute top-0 left-0 w-px h-6 bg-zinc-500 -translate-x-[0.5px]"></div>
            <!-- Contenu du stage -->
            <div class="pl-4 mt-2 border-l border-transparent group-hover:border-zinc-500 transition-colors">
              <span class="text-xs font-mono text-zinc-400 tracking-widest">ÉTÉ 2026</span>
              <h4 class="text-lg font-medium text-zinc-200 mt-1">Stage : Neuro-archéologie VR</h4>
              <p class="text-sm text-zinc-500 mt-1 font-light">IRISA / Inria (Rennes)</p>
            </div>
          </div>

        </div>

        <!-- B. Version MOBILE (Verticale adaptée) -->
        <div class="md:hidden mt-8 max-w-sm mx-auto">
          
          <!-- Période 1 : CPGE -->
          <div class="timeline-mobile-step timeline-mobile-step--prepa border-l-2 pl-6 pb-8">
            <span class="text-xs font-mono text-zinc-400 tracking-widest">2022 — 2024</span>
            <h4 class="text-lg font-medium text-zinc-200 mt-1">CPGE (PT*)</h4>
            <p class="text-sm text-zinc-500 font-light mt-1">Lycée Déodat de Séverac</p>
          </div>

          <!-- Période 2 : ENSEEIHT -->
          <div class="timeline-mobile-step timeline-mobile-step--enseeiht border-l-2 pl-6 pb-4 relative">
            <span class="text-xs font-mono text-zinc-400 tracking-widest">2024 — 2027</span>
            <h4 class="text-lg font-medium text-zinc-200 mt-1">Ingénierie Image &amp; Multimédia</h4>
            <p class="text-sm text-zinc-500 font-light mt-1 mb-8">ENSEEIHT (Toulouse INP)</p>

            <!-- Événement 3 : Stage -->
            <div class="relative mt-6">
              <span class="absolute -left-[31px] top-1 h-3 w-3 rounded-full bg-zinc-400 ring-4 ring-black"></span>
              <span class="text-xs font-mono text-zinc-400 tracking-widest">ÉTÉ 2026</span>
              <h4 class="text-lg font-medium text-zinc-200 mt-1">Stage : Neuro-archéologie VR</h4>
              <p class="text-sm text-zinc-500 font-light mt-1">IRISA / Inria (Rennes)</p>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- BANDEAU COMPÉTENCES -->
  <section class="skills-marquee-shell overflow-hidden border-y py-5" aria-label="Compétences techniques">
    <div class="skills-marquee flex w-max hover:[animation-play-state:paused]">
      {[false, true].map((isDuplicate) => (
        <ul
          class="flex shrink-0 items-center gap-3 pr-6"
          role="list"
          aria-hidden={isDuplicate ? 'true' : undefined}
        >
          {skillCategories.map((category, index) => (
            <li class={`flex shrink-0 items-center gap-3 ${index > 0 ? 'ml-6' : ''}`}>
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-600">
                {category.name}
              </span>
              {category.skills.map((skill) => (
                <span class="skill-pill rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 font-mono text-sm uppercase tracking-wider text-zinc-400 transition duration-200 hover:scale-105 hover:border-white/30 hover:text-white">
                  {skill}
                </span>
              ))}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- PROJETS & DÉCOUVERTES -->
  <section class="py-32 flex flex-col justify-center px-6 overflow-hidden" id="niveau-1">

    <div class="max-w-7xl mx-auto w-full">

      <!-- Titre de section -->
      <div class="mb-10 flex flex-col items-center text-center will-change-transform" id="projets-titre">
        <span class="text-xs font-mono uppercase tracking-widest mb-3 text-zinc-500">Portfolio</span>
        <h2 class="text-3xl md:text-5xl font-medium tracking-tight text-white">Projets &amp; Découvertes</h2>
        <p class="mt-4 text-zinc-500 text-sm font-light max-w-lg">Découvrez mes travaux académiques et personnels.</p>
      </div>

      <div class="home-projects" id="projets-panneaux">
        <a href="/projets" class="home-projects__all">
          <span>Tous les projets <span class="home-projects__count">{total} projets · Voir la page complète</span></span>
          <span class="font-mono text-xs">Ouvrir ↗</span>
        </a>

        <div class="home-project-groups">
          <section class="home-project-group" aria-labelledby="home-academic-title">
            <header class="home-project-group__header">
              <span class="eyebrow">Catégorie 01</span>
              <h3 id="home-academic-title">Académiques</h3>
              <p>Projets scolaires &amp; universitaires · {countAca} projets</p>
            </header>
            <div class="projects-grid">
              {academiques.map(project => <ProjectCard project={project} />)}
            </div>
          </section>

          <section class="home-project-group" aria-labelledby="home-personal-title">
            <header class="home-project-group__header">
              <span class="eyebrow">Catégorie 02</span>
              <h3 id="home-personal-title">Expériences Perso.</h3>
              <p>Projets personnels &amp; explorations · {countPerso} projets</p>
            </header>
            <div class="projects-grid">
              {persos.map(project => <ProjectCard project={project} />)}
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <section class="skills-detail-section px-6 py-24" aria-labelledby="skills-detail-title">
    <div class="skills-detail-inner">
      <header class="skills-detail-header">
        <span class="eyebrow">Savoir-faire</span>
        <h2 id="skills-detail-title">Compétences</h2>
      </header>
      <div class="skills-detail-grid">
        {skillCategories.map((category, index) => (
          <article class="skills-detail-card">
            <p class="skills-detail-index">CAT. 0{index + 1}</p>
            <h3>{category.name}</h3>
            <ul>
              {category.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .about-skill {
    border: 1px solid rgb(138 85 42 / 28%);
    background: rgb(138 85 42 / 5%);
    padding: 0.375rem 1rem;
    color: #614326;
    font: 0.75rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .home-projects {
    border-top: 1px solid rgb(138 85 42 / 30%);
  }

  .home-projects__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(138 85 42 / 22%);
    padding: 1.25rem 0;
    color: #302b25;
    font-size: 0.9rem;
  }

  .home-projects__all:hover { color: #8a552a; }
  .home-projects__count {
    display: block;
    margin-top: 0.25rem;
    color: #62594f;
    font: 0.7rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .home-project-group {
    padding-block: clamp(2rem, 5vw, 4rem);
    border-bottom: 1px solid rgb(138 85 42 / 22%);
  }

  .home-project-group__header { margin-bottom: 1.5rem; }
  .home-project-group__header h3 {
    margin-top: 0.5rem;
    color: #302b25;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .home-project-group__header p {
    margin-top: 0.35rem;
    color: #62594f;
  }

  .timeline-line { height: 2px; }
  .timeline-line--prepa { background: #9b6840; }
  .timeline-line--enseeiht { background: #bd8b4e; }
  .timeline-step--prepa:hover > div:first-child { border-color: #9b6840; }
  .timeline-step--prepa > div > span { color: #89552f; }
  .timeline-step--prepa h4,
  .timeline-step--enseeiht h4,
  .timeline-step--stage h4 { color: #302b25; }
  .timeline-step--prepa p,
  .timeline-step--enseeiht p,
  .timeline-step--stage p { color: #62594f; }
  .timeline-step--enseeiht:hover > div:first-child { border-color: #bd8b4e; }
  .timeline-step--enseeiht > div > span { color: #805923; }
  .timeline-step--stage > div:first-child {
    background: #a66e45;
    box-shadow: 0 0 0 4px #f4f0e8;
  }
  .timeline-step--stage > div:nth-child(2) { background: #a66e45; }
  .timeline-step--stage:hover > div:last-child { border-color: #a66e45; }
  .timeline-step--stage > div > span { color: #89552f; }
  .timeline-mobile-step--prepa { border-color: #9b6840; }
  .timeline-mobile-step--enseeiht { border-color: #bd8b4e; }
  .timeline-mobile-step > span { color: #89552f; }
  .timeline-mobile-step h4 { color: #302b25; }
  .timeline-mobile-step p { color: #62594f; }
  .timeline-mobile-step--enseeiht .relative > span:first-child { background: #a66e45; }

  .skills-detail-section {
    background: #eee8dc;
    border-top: 1px solid rgb(138 85 42 / 24%);
  }
  .skills-detail-inner { width: min(100%, 80rem); margin-inline: auto; }
  .skills-detail-header { margin-bottom: 2rem; }
  .skills-detail-header h2 {
    margin-top: 0.6rem;
    color: #302b25;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .skills-detail-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .skills-detail-card {
    border: 1px solid rgb(102 70 42 / 20%);
    background: rgb(255 255 255 / 48%);
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }
  .skills-detail-index {
    color: #62513f;
    font: 0.65rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
  }
  .skills-detail-card h3 {
    margin-top: 0.75rem;
    color: #754a2b;
    font-size: 1.1rem;
    font-weight: 500;
  }
  .skills-detail-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .skills-detail-card li {
    border: 1px solid rgb(138 85 42 / 22%);
    background: #f8f5ef;
    padding: 0.45rem 0.65rem;
    color: #3f3932;
    font: 0.72rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
  }

  .skills-marquee {
    animation: skills-marquee-scroll 36s linear infinite;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  @keyframes skills-marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills-marquee {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .home-projects .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .skills-detail-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 540px) {
    .home-projects .projects-grid { grid-template-columns: 1fr; }
  }
</style>
