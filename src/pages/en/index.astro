---
import Layout from '../../layouts/Layout.astro';
import CalibrationGrid from '../../components/CalibrationGrid.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { englishProjects } from '../../data/projects.en';
import ui from '../../i18n/en.json';

const academics = englishProjects.filter((project) => project.group === 'academique');
const personal = englishProjects.filter((project) => project.group === 'perso');
const skills = [
  { name: 'XR & Vision', skills: ['Unity', 'OpenXR', 'OpenCV', 'YOLO', 'Eye-tracking'] },
  { name: 'Core & System', skills: ['C++', 'C#', 'Python', 'Linux Native', 'Java', 'Kotlin'] },
  { name: 'Web & Tools', skills: ['Astro', 'Tailwind CSS', 'Git', 'Spring Boot', 'MATLAB', 'Blender'] },
];
---

<Layout title="Batiste COMET-BARTHE | Portfolio" lang="en">
  <section class="h-screen flex flex-col items-center justify-center relative overflow-hidden hero-shell" id="hero-section" aria-label={ui.home.heroLabel}>
    <CalibrationGrid />
    <div class="text-center px-4 z-10 relative">
      <div class="hero-status inline-flex items-center gap-2 mb-8 px-4 py-2 text-xs font-mono tracking-widest uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
        {ui.home.availability}
      </div>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-light tracking-tight text-white leading-[1.05]">
        {ui.home.heroHeadingFirst}<br />
        <span class="font-semibold text-[var(--accent)]">Image &amp; Multimedia</span>
      </h1>
      <p class="mt-6 text-zinc-400 text-base font-light max-w-md mx-auto leading-relaxed">VR · Computer Graphics · C++ · Linux Native</p>
      <div class="mt-14 flex flex-col items-center gap-3">
        <a href="#a-propos" class="group flex flex-col items-center gap-2 text-zinc-500 hover:text-zinc-300 transition-colors duration-300">
          <span class="text-xs font-mono uppercase tracking-[0.3em]">{ui.home.discover}</span>
          <svg class="w-4 h-4 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="min-h-screen py-32 px-6 flex flex-col justify-center" id="a-propos">
    <div class="max-w-6xl mx-auto w-full">
      <div class="mb-16 flex flex-col items-center text-center">
        <span class="text-xs font-mono uppercase tracking-widest mb-3 text-zinc-500">{ui.home.about}</span>
        <h2 class="text-3xl md:text-5xl font-medium tracking-tight">{ui.home.profileJourney}</h2>
      </div>
      <div class="max-w-3xl mx-auto text-center space-y-8 mb-24">
        <p class="text-zinc-400 leading-relaxed text-lg font-light">{ui.home.profileFirst}</p>
        <p class="text-zinc-400 leading-relaxed text-lg font-light">{ui.home.profileSecond}</p>
        <div class="pt-4 flex flex-wrap justify-center gap-3">
          <span class="about-skill">VR / XR</span>
          <span class="about-skill">Computer Graphics</span>
          <span class="about-skill">Linux Native</span>
          <span class="about-skill">{ui.home.englishLevel}</span>
        </div>
      </div>
      <div class="w-full mt-12">
        <div class="hidden md:block relative w-full mt-10 h-96 timeline">
          <div class="absolute top-1/2 left-0 w-full h-px bg-zinc-800/80"></div>
          <div class="absolute top-1/2 -translate-y-[0.5px] left-0 w-[35%] h-[2px] timeline-line timeline-line--prepa"></div>
          <div class="absolute top-1/2 -translate-y-[0.5px] left-[35%] w-[65%] h-[2px] timeline-line timeline-line--enseeiht"></div>
          <div class="timeline-line--master"></div>
          <span class="timeline-marker timeline-marker--prepa" aria-hidden="true"></span>
          <span class="timeline-marker timeline-marker--enseeiht" aria-hidden="true"></span>
          <span class="timeline-marker timeline-marker--master" aria-hidden="true"></span>
          <div class="absolute top-1/2 left-[35%] h-8 w-px timeline-separator -translate-y-1/2"></div>
          <div class="absolute top-0 left-0 w-[35%] h-1/2 flex flex-col justify-end pb-6 pl-4 group timeline-step timeline-step--prepa">
            <div class="border-l border-transparent group-hover:border-zinc-500 transition-colors pl-2">
              <span class="text-xs font-mono text-zinc-400 tracking-widest">2022 — 2024</span>
              <h4 class="text-lg font-medium text-zinc-200 mt-2">CPGE (PT*)</h4>
              <p class="text-sm text-zinc-500 mt-1 font-light">{ui.home.preparatorySchool}</p>
            </div>
          </div>
          <div class="absolute top-0 left-[35%] w-[65%] h-1/2 flex flex-col justify-end pb-6 pl-8 group timeline-step timeline-step--enseeiht">
            <div class="border-l border-transparent group-hover:border-zinc-500 transition-colors pl-2">
              <span class="text-xs font-mono text-zinc-400 tracking-widest">2024 — 2027</span>
              <h4 class="text-lg font-medium text-zinc-200 mt-2">{ui.home.engineeringDegree}</h4>
              <p class="text-sm text-zinc-500 mt-1 font-light">ENSEEIHT (Toulouse INP)</p>
            </div>
          </div>
          <div class="absolute top-1/2 left-[70%] w-[30%] h-1/2 flex flex-col justify-start pt-6 pl-0 group timeline-step timeline-step--stage">
            <div class="absolute top-0 left-0 w-3 h-3 bg-zinc-400 rounded-full -translate-y-[6px] -translate-x-[6px] ring-4 ring-black group-hover:scale-110 transition-transform z-10"></div>
            <div class="absolute top-0 left-0 w-px h-6 bg-zinc-500 -translate-x-[0.5px]"></div>
            <div class="pl-4 mt-2 border-l border-transparent group-hover:border-zinc-500 transition-colors">
              <span class="text-xs font-mono text-zinc-400 tracking-widest">{ui.home.stageDate}</span>
              <h4 class="text-lg font-medium text-zinc-200 mt-1">{ui.home.stage}</h4>
              <p class="text-sm text-zinc-500 mt-1 font-light">IRISA / Inria (Rennes)</p>
            </div>
          </div>
          <div class="timeline-step timeline-step--master">
            <span class="timeline-master-connector" aria-hidden="true"></span>
            <div class="timeline-step__content">
              <h4 class="text-lg font-medium">{ui.home.researchMaster}</h4>
            </div>
          </div>
        </div>
        <div class="md:hidden mt-8 max-w-sm mx-auto">
          <div class="timeline-mobile-step timeline-mobile-step--prepa border-l-2 pl-6 pb-8">
            <span class="text-xs font-mono text-zinc-400 tracking-widest">2022 — 2024</span>
            <h4 class="text-lg font-medium text-zinc-200 mt-1">CPGE (PT*)</h4>
            <p class="text-sm text-zinc-500 font-light mt-1">{ui.home.preparatorySchool}</p>
          </div>
          <div class="timeline-mobile-step timeline-mobile-step--enseeiht border-l-2 pl-6 pb-4 relative">
            <span class="text-xs font-mono text-zinc-400 tracking-widest">2024 — 2027</span>
            <h4 class="text-lg font-medium text-zinc-200 mt-1">{ui.home.engineeringDegree}</h4>
            <p class="text-sm text-zinc-500 font-light mt-1 mb-8">ENSEEIHT (Toulouse INP)</p>
            <div class="relative mt-6">
              <span class="absolute -left-[31px] top-1 h-3 w-3 rounded-full bg-zinc-400 ring-4 ring-black"></span>
              <span class="text-xs font-mono text-zinc-400 tracking-widest">{ui.home.stageDate}</span>
              <h4 class="text-lg font-medium text-zinc-200 mt-1">{ui.home.stage}</h4>
              <p class="text-sm text-zinc-500 font-light mt-1">IRISA / Inria (Rennes)</p>
            </div>
            <div class="timeline-mobile-step--master relative mt-6 border-l-2 pl-6">
              <span class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-zinc-400 ring-4 ring-black"></span>
              <h4 class="text-lg font-medium mt-1">{ui.home.researchMaster}</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="skills-marquee-shell overflow-hidden border-y py-5" aria-label={ui.home.marqueeLabel}>
    <div class="skills-marquee flex w-max hover:[animation-play-state:paused]">
      {[false, true].map((duplicate) => (
        <ul class="flex shrink-0 items-center gap-3 pr-6" role="list" aria-hidden={duplicate ? 'true' : undefined}>
          {skills.map((category, index) => (
            <li class={`flex shrink-0 items-center gap-3 ${index > 0 ? 'ml-6' : ''}`}>
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-600">{category.name}</span>
              {category.skills.map((skill) => <span class="skill-pill rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 font-mono text-sm uppercase tracking-wider text-zinc-400">{skill}</span>)}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <section class="py-32 flex flex-col justify-center px-6 overflow-hidden" id="projects">
    <div class="max-w-7xl mx-auto w-full">
      <div class="mb-10 flex flex-col items-center text-center" id="projets-titre">
        <span class="text-xs font-mono uppercase tracking-widest mb-3 text-zinc-500">{ui.common.portfolio}</span>
        <h2 class="text-3xl md:text-5xl font-medium tracking-tight text-white">{ui.home.projectsTitle}</h2>
        <p class="mt-4 text-zinc-500 text-sm font-light max-w-lg">{ui.home.projectsDescription}</p>
      </div>
      <div class="home-projects" id="projets-panneaux">
        <a href="/en/projets" class="home-projects__all">
          <span>{ui.common.allProjects}<span class="home-projects__count">{englishProjects.length} {ui.common.projectsCount} · {ui.common.allProjectsDescription}</span></span>
          <span class="font-mono text-xs">{ui.common.open} ↗</span>
        </a>
        <div class="home-project-groups">
          <details class="home-project-group home-project-group--academic" open>
            <summary class="home-project-group__header">
              <span class="eyebrow">{ui.home.categoryLabel} 01</span>
              <span class="home-project-group__title" role="heading" aria-level="3">{ui.common.academic}</span>
              <span class="home-project-group__description">{ui.common.academicProjects} · {academics.length} {ui.common.projectsCount}</span>
              <span class="home-project-group__toggle" aria-hidden="true"></span>
            </summary>
            <div class="projects-grid">{academics.map((project) => <ProjectCard project={project} lang="en" />)}</div>
          </details>
          <details class="home-project-group home-project-group--personal" open>
            <summary class="home-project-group__header">
              <span class="eyebrow">{ui.home.categoryLabel} 02</span>
              <span class="home-project-group__title" role="heading" aria-level="3">{ui.common.personal}</span>
              <span class="home-project-group__description">{ui.common.personalProjects} · {personal.length} {ui.common.projectsCount}</span>
              <span class="home-project-group__toggle" aria-hidden="true"></span>
            </summary>
            <div class="projects-grid">{personal.map((project) => <ProjectCard project={project} lang="en" />)}</div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="skills-detail-section px-6 py-24" aria-labelledby="skills-detail-title">
    <div class="skills-detail-inner">
      <header class="skills-detail-header">
        <span class="eyebrow">{ui.home.knowHow}</span>
        <h2 id="skills-detail-title">{ui.home.skills}</h2>
      </header>
      <div class="skills-detail-grid">
        {skills.map((category, index) => (
          <article class="skills-detail-card">
            <p class="skills-detail-index">CAT. 0{index + 1}</p>
            <h3>{category.name}</h3>
            <ul>{category.skills.map((skill) => <li>{skill}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-skill { border: 1px solid var(--about-skill-border); background: var(--about-skill-bg); padding: 0.375rem 1rem; color: var(--about-skill-text); font: 0.75rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .home-projects { border-top: 1px solid var(--border-subtle); }
  .home-projects__all { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--border-subtle); padding: 1.25rem 0; color: var(--text-primary); font-size: 0.9rem; }
  .home-projects__count { display: block; margin-top: 0.25rem; color: var(--text-muted); font: 0.7rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .home-project-group { padding-block: clamp(2rem, 5vw, 4rem); border-bottom: 1px solid var(--border-subtle); }
  .home-project-group__header { margin-bottom: 1.5rem; padding: 0; }
  .home-project-group__title { color: var(--text-primary); transition: color 180ms ease; }
  .home-project-group--academic .home-project-group__title { color: var(--accent-academic); }
  .home-project-group--personal .home-project-group__title { color: var(--accent-personal); }
  .home-project-group__description { color: var(--text-muted); }
  .skills-detail-section { background: var(--skills-section-bg); border-top: 1px solid var(--border-subtle); }
  .skills-detail-inner { width: min(100%, 80rem); margin-inline: auto; }
  .skills-detail-header { margin-bottom: 2rem; }
  .skills-detail-header h2 { margin-top: 0.6rem; color: var(--text-primary); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; letter-spacing: -0.04em; }
  .skills-detail-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .skills-detail-card { border: 1px solid var(--skills-card-border); background: var(--skills-card-bg); padding: clamp(1.25rem, 2.5vw, 2rem); }
  .skills-detail-index { color: var(--skills-index); font: 0.65rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.12em; }
  .skills-detail-card h3 { margin-top: 0.75rem; color: var(--accent); font-size: 1.1rem; font-weight: 500; }
  .skills-detail-card ul { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem; }
  .skills-detail-card li { border: 1px solid var(--skills-tag-border); background: var(--skills-tag-bg); padding: 0.45rem 0.65rem; color: var(--skills-tag-text); font: 0.8rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .skills-marquee { animation: skills-marquee-scroll 36s linear infinite; mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); }
  @keyframes skills-marquee-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .skills-marquee { animation: none; } }
  @media (max-width: 760px) { .skills-detail-grid { grid-template-columns: 1fr; } }
</style>
