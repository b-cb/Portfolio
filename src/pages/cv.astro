---
import Layout from '../layouts/Layout.astro';
import ProtectedCvLink from '../components/ProtectedCvLink.astro';
---

<Layout title="CV | Batiste COMET-BARTHE">
  <main class="min-h-screen px-6 pt-40 pb-24">
    <div class="max-w-4xl mx-auto reveal">
      <p class="eyebrow">Document</p>
      <h1 class="text-5xl md:text-7xl font-medium tracking-tight mt-4">Curriculum vitae</h1>
      <p class="text-zinc-400 text-lg mt-6 max-w-xl leading-relaxed">Consultez mon CV dans le navigateur.</p>
      <ProtectedCvLink class="inline-flex mt-10 text-sm font-mono text-[var(--accent)] border-b border-[var(--accent)] pb-2">Ouvrir le CV</ProtectedCvLink>
    </div>
  </main>
</Layout>
