---
// src/pages/projets/neuro-archeologie.astro
import { Image } from 'astro:assets';
 
import Layout from '../../layouts/Layout.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import Artefacts from '../../Images/Stage2A.png'
import Temple from '../../Images/Stage2ATemple.png'
 
---
 
<Layout title="Neuro-archéologie VR | Batiste COMET-BARTHE" backHref="/#niveau-1">
 
 
  <ProjectHero category="Stage IRISA / Inria · Rennes · Été 2026" title="Neuro-archéologie" accent="VR" description="Conception d'outils de visualisation et de heatmaps 3D pour analyser des relevés d'exploration en réalité virtuelle, appliqués à l'étude d'artefacts et d'un temple gallo-romain." tags={['OpenXR', 'C++', 'HTML', 'Python', 'Unity']} image={Artefacts} imageAlt="Artefact" />
 
  <!-- CORPS DU PROJET -->
  <section class="px-6 pb-32" style="background: #09090b;">
    <ProjectSection variant="wide">
    <div class="max-w-4xl mx-auto space-y-16">
 
      <!-- Séparateur -->
      <div class="w-full h-px" style="background: linear-gradient(90deg, transparent, rgba(120,80,220,0.3), transparent);"></div>
 
      <!-- Contexte -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4" style="color: rgba(167,139,250,0.7);">01 — Contexte</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light">
              Accueilli au sein de l'équipe de recherche Seamless (IRISA), spécialisée en réalité étendue, j'ai effectué mon stage de M1 autour du développement d'un pipeline de visualisation de données spatiales. Dans le cadre de la thèse de Maxime Dumonteil, j'ai conçu des outils de rendu de heatmaps 3D sur mesure, permettant d'analyser et de représenter visuellement des parcours d'exploration complexes en réalité virtuelle.
          </p>
        </div>
      </div>
 
      <div class="w-full h-px bg-white/5"></div>
 
      <!-- Objectifs -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4" style="color: rgba(167,139,250,0.7);">02 — Objectifs</h2>
        </div>
        <div class="md:col-span-2 space-y-3">
          <p class="text-zinc-400 leading-relaxed font-light">Permettre une analyse visuelle fine des relevés d'exploration recueillis en VR, à deux échelles différentes :</p>
          <ul class="space-y-2 mt-4">
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-violet-500 flex-shrink-0"></span>
              Concevoir une interface web permettant d'analyser les parcours de 60 participants, issus de 3 pays différents, autour de 15 artefacts.
            </li>
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-violet-500 flex-shrink-0"></span>
              Développer un moteur de rendu dédié à l'analyse des relevés de 40 participants lors de la visite virtuelle d'un temple gallo-romain dédié à Mars.
            </li>
            
          </ul>
        </div>
      </div>
 
      <div class="w-full h-px bg-white/5"></div>
 
      <!-- Technologies -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4" style="color: rgba(167,139,250,0.7);">03 — Technologies</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light mb-6">Une page HTML/JavaScript légère pour la visualisation des heatmaps sur les artefacts, privilégiant fluidité et accessibilité.</p>
          <p class="text-zinc-400 leading-relaxed font-light mb-6">Un moteur de rendu développé en C++ pour le temple, la taille de la zone à traiter nécessitant des performances plus poussées.</p>
 
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">Unity</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">HTML et JavaScript</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">C++</span>
          </div>
        </div>
      </div>
 
      <div class="w-full h-px bg-white/5"></div>
 
      <!-- Image secondaire placeholder -->
      <div class="w-full rounded-2xl overflow-hidden flex items-center justify-center"
        style="height: 400px; background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.08);">
        <Image 
              src={Temple},
              alt = 'Temple',
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
        />
      </div>
 
      <div class="w-full h-px bg-white/5"></div>
 
      <!-- Résultats & Apprentissages -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4" style="color: rgba(167,139,250,0.7);">04 — Résultats</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light">
              Les résultats ont dépassé les attentes initiales : les pages consacrées aux artefacts restent fluides même en affichant simultanément les relevés des 15 artefacts et des 60 participants. Le moteur de rendu C++ tourne quant à lui à 90 FPS constants, avec un temps de recalcul inférieur à 3 secondes lors des changements de shader — l'un des principaux défis techniques du projet.
          </p>
        </div>
      </div>
 
      <div class="w-full h-px bg-white/5"></div>
 
    </div>
    </ProjectSection>
  </section>
 
  <!-- FIN DE PAGE -->
  <section class="px-6 pb-24" style="background: #09090b;">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-6 pt-4">
 
      <div class="w-12 h-px" style="background: rgba(167,139,250,0.4);"></div>
 
      <p class="text-zinc-500 text-sm font-light max-w-md">
        Ce projet fait partie de mon parcours de recherche en réalité étendue et visualisation de données.
      </p>
 
      <a href="/#niveau-1"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-mono uppercase tracking-widest transition-colors duration-300"
        style="background: rgba(120,80,220,0.12); border: 1px solid rgba(120,80,220,0.3); color: rgba(167,139,250,0.9);">
        ← Retour au portfolio
      </a>
 
    </div>
  </section>
 
</Layout>