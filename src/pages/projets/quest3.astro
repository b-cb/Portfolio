---
// src/pages/projets/quest3.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Déploiement Quest 3 | Batiste COMET-BARTHE" backHref="/#niveau-1">


  <!-- HERO PROJET -->
  <section class="pt-32 pb-20 px-6" style="background: linear-gradient(180deg, #09090b 0%, #130a12 100%);">
    <div class="max-w-4xl mx-auto">

      <div class="inline-flex items-center gap-2 mb-6 px-3 py-1.5 rounded-full text-xs font-mono uppercase tracking-widest"
        style="background: rgba(244,114,182,0.08); border: 1px solid rgba(244,114,182,0.3); color: rgba(249,168,212,0.9);">
        <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
        Projet Personnel · Linux Native · Meta Quest 3
      </div>

      <h1 class="text-4xl md:text-6xl font-medium text-white leading-tight mt-4">
        Déploiement<br/>
        <span style="background: linear-gradient(135deg, #f9a8d4, #f472b6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Quest 3</span>
      </h1>

      <p class="text-zinc-400 text-lg mt-6 max-w-2xl font-light leading-relaxed">
        [ Description courte du projet — à remplir. Ex : Pipeline de développement et déploiement d'applications XR sur Meta Quest 3 depuis un environnement Linux natif. ]
      </p>

      <div class="flex flex-wrap gap-3 mt-8">
        <span class="px-3 py-1 text-xs font-mono rounded-full" style="background: rgba(244,114,182,0.10); border: 1px solid rgba(244,114,182,0.3); color: rgba(249,168,212,0.9);">Unity</span>
        <span class="px-3 py-1 text-xs font-mono rounded-full" style="background: rgba(244,114,182,0.10); border: 1px solid rgba(244,114,182,0.3); color: rgba(249,168,212,0.9);">C#</span>
        <span class="px-3 py-1 text-xs font-mono rounded-full" style="background: rgba(244,114,182,0.10); border: 1px solid rgba(244,114,182,0.3); color: rgba(249,168,212,0.9);">OpenXR</span>
        <span class="px-3 py-1 text-xs font-mono rounded-full" style="background: rgba(244,114,182,0.10); border: 1px solid rgba(244,114,182,0.3); color: rgba(249,168,212,0.9);">Linux</span>
      </div>

      <div class="mt-14 w-full rounded-2xl overflow-hidden flex items-center justify-center"
        style="height: 360px; background: linear-gradient(135deg, rgba(244,114,182,0.05), rgba(9,9,11,0.9)); border: 1px solid rgba(244,114,182,0.2);">
        <div class="text-center">
          <p class="text-zinc-600 text-sm font-mono uppercase tracking-widest">[ Image / Capture du projet ]</p>
          <p class="text-zinc-700 text-xs mt-2 font-light">Déposer une image dans <code class="text-pink-950">public/</code> et remplacer ce bloc</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CORPS DU PROJET -->
  <section class="px-6 pb-32" style="background: #09090b;">
    <div class="max-w-4xl mx-auto space-y-16">

      <div class="w-full h-px" style="background: linear-gradient(90deg, transparent, rgba(244,114,182,0.3), transparent);"></div>

      <div class="grid md:grid-cols-3 gap-8">
        <div><h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-pink-400/70">01 — Contexte</h2></div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light">[ À remplir — Contexte du projet, motivation, problématique Linux native... ]</p>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <div class="grid md:grid-cols-3 gap-8">
        <div><h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-pink-400/70">02 — Objectifs</h2></div>
        <div class="md:col-span-2 space-y-3">
          <p class="text-zinc-400 leading-relaxed font-light">[ À remplir ]</p>
          <ul class="space-y-2 mt-4">
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-pink-500 flex-shrink-0"></span>[ Objectif 1 ]
            </li>
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-pink-500 flex-shrink-0"></span>[ Objectif 2 ]
            </li>
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-pink-500 flex-shrink-0"></span>[ Objectif 3 ]
            </li>
          </ul>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <div class="grid md:grid-cols-3 gap-8">
        <div><h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-pink-400/70">03 — Technologies</h2></div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light mb-6">[ À remplir ]</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">Unity</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">C#</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">OpenXR</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">ADB</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">[ Autre ]</span>
          </div>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <div class="w-full rounded-2xl overflow-hidden flex items-center justify-center"
        style="height: 260px; background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.08);">
        <p class="text-zinc-700 text-xs font-mono uppercase tracking-widest">[ Image secondaire — optionnel ]</p>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <div class="grid md:grid-cols-3 gap-8">
        <div><h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-pink-400/70">04 — Résultats</h2></div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light">[ À remplir — Résultats, difficultés spécifiques à Linux native, pipeline final. ]</p>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <div class="grid md:grid-cols-3 gap-8">
        <div><h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-pink-400/70">05 — Liens</h2></div>
        <div class="md:col-span-2 flex gap-4">
          <a href="#" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-mono text-zinc-400 hover:text-white transition-colors"
            style="border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.02);">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            [ GitHub — à remplir ]
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
