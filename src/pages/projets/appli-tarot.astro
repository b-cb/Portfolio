---
// src/pages/projets/appli-tarot.astro
import { Image } from 'astro:assets';

import Layout from '../../layouts/Layout.astro';
import Appliweb from '../../Images/Appliweb.png'
---

<Layout title="Application web Tarot/Coinche | Batiste COMET-BARTHE" backHref="/#niveau-1">

  <!-- HERO PROJET -->
  <section class="pt-32 pb-20 px-6" style="background: linear-gradient(180deg, #09090b 0%, #0d0a18 100%);">
    <div class="max-w-4xl mx-auto">

      <!-- Badge catégorie -->
      <div class="inline-flex items-center gap-2 mb-6 px-3 py-1.5 rounded-full text-xs font-mono uppercase tracking-widest"
        style="background: rgba(20, 184, 166, 0.12); border: 1px solid rgba(20, 184, 166, 0.3); color: rgba(94, 234, 212, 0.9);">
        <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
        2nd semestre M1
      </div>

      <!-- Titre -->
      <h1 class="text-4xl md:text-6xl font-medium text-white leading-tight mt-4">
        Application web<br/>
        <span style="background: linear-gradient(135deg, #2dd4bf, #14b8a6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Tarot/Coinche</span>
      </h1>

      <!-- Sous-titre / accroche -->
      <p class="text-zinc-400 text-lg mt-6 max-w-2xl font-light leading-relaxed">
        Application web permettant de jouer au tarot ou a la coinche seul ou en réseau local
      </p>

      <!-- Tags technos -->
      <div class="flex flex-wrap gap-3 mt-8">
        <span class="px-3 py-1 text-xs font-mono rounded-full" style="background: rgba(20, 184, 166, 0.15); border: 1px solid rgba(20, 184, 166, 0.3); color: rgba(94, 234, 212, 0.9);">Java</span>
        <span class="px-3 py-1 text-xs font-mono rounded-full" style="background: rgba(20, 184, 166, 0.15); border: 1px solid rgba(20, 184, 166, 0.3); color: rgba(94, 234, 212, 0.9);">Vite</span>
        <span class="px-3 py-1 text-xs font-mono rounded-full" style="background: rgba(20, 184, 166, 0.15); border: 1px solid rgba(20, 184, 166, 0.3); color: rgba(94, 234, 212, 0.9);">H2 database</span>
        <span class="px-3 py-1 text-xs font-mono rounded-full" style="background: rgba(20, 184, 166, 0.15); border: 1px solid rgba(20, 184, 166, 0.3); color: rgba(94, 234, 212, 0.9);">SpringBoot 3</span>
      </div>

      <!-- Image hero -->
      <div class="mt-14 w-full rounded-2xl overflow-hidden flex items-center justify-center"
        style="height: 360px; background: linear-gradient(135deg, rgba(20, 184, 166, 0.08), rgba(9,9,11,0.9)); border: 1px solid rgba(20, 184, 166, 0.2);">
        <Image 
              src={Appliweb}
              alt="Appli Tarot"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
        />
      </div>

    </div>
  </section>

  <!-- CORPS DU PROJET (Placholder Template) -->
  <section class="px-6 pb-32" style="background: #09090b;">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <div class="w-full h-px" style="background: linear-gradient(90deg, transparent, rgba(20, 184, 166, 0.3), transparent);"></div>

      <!-- Contexte -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4" style="color: rgba(94, 234, 212, 0.7);">01 — Contexte</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light">
              [ À remplir — Contexte et description détaillée de ce projet. ]
          </p>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <!-- Objectifs -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4" style="color: rgba(94, 234, 212, 0.7);">02 — Objectifs</h2>
        </div>
        <div class="md:col-span-2 space-y-3">
          <p class="text-zinc-400 leading-relaxed font-light">[ À remplir — Objectifs principaux du projet ]</p>
          <ul class="space-y-2 mt-4">
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-teal-500 flex-shrink-0"></span>
              Objectif 1
            </li>
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-teal-500 flex-shrink-0"></span>
              Objectif 2
            </li>
          </ul>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <!-- Résultats & Apprentissages -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4" style="color: rgba(94, 234, 212, 0.7);">03 — Résultats</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light">
            [ À remplir — Quels résultats avez-vous obtenus ? Qu'avez-vous appris ? Quelles difficultés avez-vous rencontrées ? ]
          </p>
        </div>
      </div>

    </div>
  </section>
</Layout>
