---
// src/pages/projets/globe-historique.astro
import Layout from '../../layouts/Layout.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import ProjectSection from '../../components/ProjectSection.astro';
---

<Layout title="Globe Historique Mobile | Batiste COMET-BARTHE" backHref="/#niveau-1">


  <ProjectHero category="Projet Universitaire · ENSEEIHT" title="Globe Historique" accent="Mobile" description="[ Description courte du projet — à remplir. Ex : Application Android de visualisation historique avec rendu 3D d'un globe interactif. ]" tags={['Kotlin', 'Jetpack Compose', 'MapLibre', 'Room SQLite']} />

  <!-- CORPS DU PROJET -->
  <section class="px-6 pb-32" style="background: #09090b;">
    <ProjectSection variant="wide">
    <div class="max-w-4xl mx-auto space-y-16">

      <div class="w-full h-px" style="background: linear-gradient(90deg, transparent, rgba(16,185,129,0.3), transparent);"></div>

      <!-- Contexte -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-emerald-400/70">01 — Contexte</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light">[ À remplir — Décrivez le contexte du projet : cours, équipe, objectif pédagogique... ]</p>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <!-- Objectifs -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-emerald-400/70">02 — Objectifs</h2>
        </div>
        <div class="md:col-span-2 space-y-3">
          <p class="text-zinc-400 leading-relaxed font-light">[ À remplir ]</p>
          <ul class="space-y-2 mt-4">
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-emerald-500 flex-shrink-0"></span>[ Objectif 1 ]
            </li>
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-emerald-500 flex-shrink-0"></span>[ Objectif 2 ]
            </li>
            <li class="flex items-start gap-3 text-zinc-500 text-sm font-light">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-emerald-500 flex-shrink-0"></span>[ Objectif 3 ]
            </li>
          </ul>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <!-- Technologies -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-emerald-400/70">03 — Technologies</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light mb-6">[ À remplir ]</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">Kotlin</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">Jetpack Compose</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">MapLibre</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">Room SQLite</span>
            <span class="px-3 py-1.5 text-xs font-mono rounded" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a1a1aa;">[ Autre ]</span>
          </div>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <div class="w-full rounded-2xl overflow-hidden flex items-center justify-center"
        style="height: 260px; background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.08);">
        <p class="text-zinc-700 text-xs font-mono uppercase tracking-widest">[ Image secondaire — optionnel ]</p>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <!-- Résultats -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-emerald-400/70">04 — Résultats</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-zinc-400 leading-relaxed font-light">[ À remplir — Résultats, difficultés rencontrées, apprentissages. ]</p>
        </div>
      </div>

      <div class="w-full h-px bg-white/5"></div>

      <!-- Liens -->
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest mb-4 text-emerald-400/70">05 — Liens</h2>
        </div>
        <div class="md:col-span-2 flex gap-4">
          <a href="#" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-mono text-zinc-400 hover:text-white transition-colors"
            style="border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.02);">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            [ GitHub — à remplir ]
          </a>
        </div>
      </div>

    </div>
    </ProjectSection>
  </section>

</Layout>
