---
// src/pages/projets/index.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Projets & Découvertes | Batiste COMET-BARTHE" backHref="/#niveau-1">

  <!-- HERO PAGE PROJETS -->
  <section class="pt-32 pb-16 px-6" style="background: linear-gradient(180deg, #09090b 0%, #0d0a18 100%);">
    <div class="max-w-6xl mx-auto">
      <span class="text-xs font-mono uppercase tracking-widest" style="color: rgba(167,139,250,0.7);">Portfolio</span>
      <h1 class="text-4xl md:text-6xl font-medium text-white mt-4 leading-tight">
        Projets &amp;<br/>
        <span style="background: linear-gradient(135deg, #a78bfa, #60a5fa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Découvertes</span>
      </h1>
      <p class="text-zinc-400 text-lg mt-6 max-w-2xl font-light leading-relaxed">
        Découvrez l'ensemble de mes travaux académiques et personnels.
      </p>
    </div>
  </section>

  <!-- CONTENU PRINCIPAL AVEC LES PANNEAUX -->
  <section class="px-6 pb-32" style="background: #09090b;">
    <div class="max-w-7xl mx-auto w-full">

      <!-- Deux panneaux expandables -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start" id="projets-panneaux">

        <!-- ═══════════════════════════════════════════ -->
        <!-- PANNEAU GAUCHE : Académiques / Scolaires   -->
        <!-- ═══════════════════════════════════════════ -->
        <div class="panneau rounded-3xl overflow-hidden transition-all duration-500"
          style="border: 1px solid rgba(167,139,250,0.15); background: rgba(120,80,220,0.04);">

          <!-- Header cliquable -->
          <button class="panneau-header w-full p-8 flex items-center justify-between text-left group"
            data-cible="panneau-academique" aria-expanded="true">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest mb-2 block" style="color: rgba(167,139,250,0.7);">Catégorie 01</span>
              <h3 class="text-2xl font-medium text-white group-hover:text-violet-200 transition-colors">Académiques</h3>
              <p class="text-sm text-zinc-500 mt-1 font-light">Projets scolaires &amp; universitaires · 2 projets</p>
            </div>
            <div class="panneau-icone flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center transition-all duration-500 ml-4"
              style="border: 1px solid rgba(167,139,250,0.25); background: rgba(120,80,220,0.08);">
              <svg class="panneau-plus w-5 h-5 text-violet-400 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="transform: rotate(45deg);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </div>
          </button>

          <!-- Contenu expandable -->
          <div class="panneau-contenu overflow-hidden" id="panneau-academique"
            style="max-height: 2000px; transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1);">
            <div class="px-6 pb-8 grid grid-cols-1 sm:grid-cols-2 gap-4">

              <!-- Carte A1 : Neuro-archéologie VR -->
              <a href="/projets/neuro-archeologie" class="projet-carte group block rounded-2xl overflow-hidden transition-all duration-300"
                style="border: 1px solid rgba(120,80,220,0.2); background: linear-gradient(160deg, rgba(18,12,30,0.9) 0%, rgba(12,12,18,0.95) 100%);">
                <!-- Vignette image -->
                <div class="h-36 flex items-center justify-center text-violet-400/30 text-xs font-mono uppercase tracking-widest relative overflow-hidden"
                  style="background: linear-gradient(135deg, rgba(120,80,220,0.1) 0%, rgba(10,8,18,0.9) 100%); border-bottom: 1px solid rgba(120,80,220,0.15);">
                  <span class="absolute inset-0" style="background: radial-gradient(ellipse at 50% -20%, rgba(120,80,220,0.25), transparent 65%);"></span>
                  <span class="z-10 select-none">[ Image à venir ]</span>
                  <!-- Flèche hover -->
                  <div class="absolute top-3 right-3 w-7 h-7 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    style="background: rgba(120,80,220,0.3); border: 1px solid rgba(167,139,250,0.3);">
                    <svg class="w-3 h-3 text-violet-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                    </svg>
                  </div>
                </div>
                <div class="p-5">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
                    <span class="text-xs font-mono tracking-widest" style="color: rgba(167,139,250,0.7);">Été 2026 · Stage IRISA</span>
                  </div>
                  <h4 class="font-semibold text-sm text-white group-hover:text-violet-200 transition-colors">Neuro-archéologie VR</h4>
                  <p class="text-xs text-zinc-500 mt-1.5 font-light leading-relaxed">Eye-tracking 3D sur un temple gallo-romain reconstitué en VR.</p>
                  <div class="flex gap-1.5 mt-4">
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(120,80,220,0.15); color: rgba(167,139,250,0.8);">OpenXR</span>
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(120,80,220,0.15); color: rgba(167,139,250,0.8);">C++</span>
                  </div>
                </div>
              </a>

              <!-- Carte A2 : Globe Historique -->
              <a href="/projets/globe-historique" class="projet-carte group block rounded-2xl overflow-hidden transition-all duration-300"
                style="border: 1px solid rgba(16,185,129,0.2); background: linear-gradient(160deg, rgba(10,20,18,0.9) 0%, rgba(12,12,18,0.95) 100%);">
                <div class="h-36 flex items-center justify-center text-emerald-400/30 text-xs font-mono uppercase tracking-widest relative overflow-hidden"
                  style="background: linear-gradient(135deg, rgba(16,185,129,0.08) 0%, rgba(10,12,18,0.9) 100%); border-bottom: 1px solid rgba(16,185,129,0.15);">
                  <span class="absolute inset-0" style="background: radial-gradient(ellipse at 50% -20%, rgba(16,185,129,0.2), transparent 65%);"></span>
                  <span class="z-10 select-none">[ Image à venir ]</span>
                  <div class="absolute top-3 right-3 w-7 h-7 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    style="background: rgba(16,185,129,0.25); border: 1px solid rgba(110,231,183,0.3);">
                    <svg class="w-3 h-3 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                    </svg>
                  </div>
                </div>
                <div class="p-5">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span class="text-xs font-mono tracking-widest text-emerald-400/70">Projet universitaire</span>
                  </div>
                  <h4 class="font-semibold text-sm text-white group-hover:text-emerald-200 transition-colors">Globe Historique Mobile</h4>
                  <p class="text-xs text-zinc-500 mt-1.5 font-light leading-relaxed">App Kotlin avec Jetpack Compose, Room SQLite et rendu 3D MapLibre.</p>
                  <div class="flex gap-1.5 mt-4">
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(16,185,129,0.12); color: rgba(110,231,183,0.8);">Kotlin</span>
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(16,185,129,0.12); color: rgba(110,231,183,0.8);">MapLibre</span>
                  </div>
                </div>
              </a>

              <!-- Carte A3 : Placeholder -->
              <div class="projet-carte block rounded-2xl overflow-hidden opacity-30"
                style="border: 1px dashed rgba(255,255,255,0.08); background: rgba(255,255,255,0.01);">
                <div class="h-36 flex items-center justify-center text-zinc-700 text-xs font-mono uppercase tracking-widest"
                  style="border-bottom: 1px dashed rgba(255,255,255,0.06);">[ À venir ]</div>
                <div class="p-5">
                  <h4 class="font-medium text-sm text-zinc-600">Projet à définir</h4>
                  <p class="text-xs text-zinc-700 mt-1.5 font-light">Placeholder — à remplir</p>
                </div>
              </div>

              <!-- Carte A4 : Placeholder -->
              <div class="projet-carte block rounded-2xl overflow-hidden opacity-30"
                style="border: 1px dashed rgba(255,255,255,0.08); background: rgba(255,255,255,0.01);">
                <div class="h-36 flex items-center justify-center text-zinc-700 text-xs font-mono uppercase tracking-widest"
                  style="border-bottom: 1px dashed rgba(255,255,255,0.06);">[ À venir ]</div>
                <div class="p-5">
                  <h4 class="font-medium text-sm text-zinc-600">Projet à définir</h4>
                  <p class="text-xs text-zinc-700 mt-1.5 font-light">Placeholder — à remplir</p>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- ════════════════════════════════════════════ -->
        <!-- PANNEAU DROIT : Expériences Personnelles    -->
        <!-- ════════════════════════════════════════════ -->
        <div class="panneau rounded-3xl overflow-hidden transition-all duration-500"
          style="border: 1px solid rgba(59,130,246,0.15); background: rgba(59,130,246,0.03);">

          <!-- Header cliquable -->
          <button class="panneau-header w-full p-8 flex items-center justify-between text-left group"
            data-cible="panneau-perso" aria-expanded="true">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest mb-2 block" style="color: rgba(147,197,253,0.7);">Catégorie 02</span>
              <h3 class="text-2xl font-medium text-white group-hover:text-blue-200 transition-colors">Expériences Perso.</h3>
              <p class="text-sm text-zinc-500 mt-1 font-light">Projets personnels &amp; explorations · 2 projets</p>
            </div>
            <div class="panneau-icone flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center transition-all duration-500 ml-4"
              style="border: 1px solid rgba(59,130,246,0.25); background: rgba(59,130,246,0.08);">
              <svg class="panneau-plus w-5 h-5 text-blue-400 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="transform: rotate(45deg);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </div>
          </button>

          <!-- Contenu expandable -->
          <div class="panneau-contenu overflow-hidden" id="panneau-perso"
            style="max-height: 2000px; transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1);">
            <div class="px-6 pb-8 grid grid-cols-1 sm:grid-cols-2 gap-4">

              <!-- Carte P1 : Tracker Golf -->
              <a href="/projets/tracker-golf" class="projet-carte group block rounded-2xl overflow-hidden transition-all duration-300"
                style="border: 1px solid rgba(59,130,246,0.2); background: linear-gradient(160deg, rgba(10,14,24,0.9) 0%, rgba(12,12,18,0.95) 100%);">
                <div class="h-36 flex items-center justify-center text-blue-400/30 text-xs font-mono uppercase tracking-widest relative overflow-hidden"
                  style="background: linear-gradient(135deg, rgba(59,130,246,0.08) 0%, rgba(10,10,18,0.9) 100%); border-bottom: 1px solid rgba(59,130,246,0.15);">
                  <span class="absolute inset-0" style="background: radial-gradient(ellipse at 50% -20%, rgba(59,130,246,0.2), transparent 65%);"></span>
                  <span class="z-10 select-none">[ Image à venir ]</span>
                  <div class="absolute top-3 right-3 w-7 h-7 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    style="background: rgba(59,130,246,0.25); border: 1px solid rgba(147,197,253,0.3);">
                    <svg class="w-3 h-3 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                    </svg>
                  </div>
                </div>
                <div class="p-5">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                    <span class="text-xs font-mono tracking-widest text-blue-400/70">Embarqué · Amazfit</span>
                  </div>
                  <h4 class="font-semibold text-sm text-white group-hover:text-blue-200 transition-colors">Tracker de Golf</h4>
                  <p class="text-xs text-zinc-500 mt-1.5 font-light leading-relaxed">Suivi de performances sportives embarqué sur montre connectée.</p>
                  <div class="flex gap-1.5 mt-4">
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(59,130,246,0.12); color: rgba(147,197,253,0.8);">Python</span>
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(59,130,246,0.12); color: rgba(147,197,253,0.8);">BLE</span>
                  </div>
                </div>
              </a>

              <!-- Carte P2 : Déploiement Quest 3 -->
              <a href="/projets/quest3" class="projet-carte group block rounded-2xl overflow-hidden transition-all duration-300"
                style="border: 1px solid rgba(244,114,182,0.2); background: linear-gradient(160deg, rgba(20,10,18,0.9) 0%, rgba(12,12,18,0.95) 100%);">
                <div class="h-36 flex items-center justify-center text-pink-400/30 text-xs font-mono uppercase tracking-widest relative overflow-hidden"
                  style="background: linear-gradient(135deg, rgba(244,114,182,0.07) 0%, rgba(10,8,18,0.9) 100%); border-bottom: 1px solid rgba(244,114,182,0.15);">
                  <span class="absolute inset-0" style="background: radial-gradient(ellipse at 50% -20%, rgba(244,114,182,0.2), transparent 65%);"></span>
                  <span class="z-10 select-none">[ Image à venir ]</span>
                  <div class="absolute top-3 right-3 w-7 h-7 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    style="background: rgba(244,114,182,0.2); border: 1px solid rgba(249,168,212,0.3);">
                    <svg class="w-3 h-3 text-pink-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                    </svg>
                  </div>
                </div>
                <div class="p-5">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
                    <span class="text-xs font-mono tracking-widest text-pink-400/70">Linux Native · XR</span>
                  </div>
                  <h4 class="font-semibold text-sm text-white group-hover:text-pink-200 transition-colors">Déploiement Quest 3</h4>
                  <p class="text-xs text-zinc-500 mt-1.5 font-light leading-relaxed">Développement et optimisation sous Linux via OpenXR, Unity et C#.</p>
                  <div class="flex gap-1.5 mt-4">
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(244,114,182,0.12); color: rgba(249,168,212,0.8);">Unity</span>
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(244,114,182,0.12); color: rgba(249,168,212,0.8);">C#</span>
                  </div>
                </div>
              </a>

              <!-- Carte P3 : Placeholder -->
              <div class="projet-carte block rounded-2xl overflow-hidden opacity-30"
                style="border: 1px dashed rgba(255,255,255,0.08); background: rgba(255,255,255,0.01);">
                <div class="h-36 flex items-center justify-center text-zinc-700 text-xs font-mono uppercase tracking-widest"
                  style="border-bottom: 1px dashed rgba(255,255,255,0.06);">[ À venir ]</div>
                <div class="p-5">
                  <h4 class="font-medium text-sm text-zinc-600">Projet à définir</h4>
                  <p class="text-xs text-zinc-700 mt-1.5 font-light">Placeholder — à remplir</p>
                </div>
              </div>

              <!-- Carte P4 : Placeholder -->
              <div class="projet-carte block rounded-2xl overflow-hidden opacity-30"
                style="border: 1px dashed rgba(255,255,255,0.08); background: rgba(255,255,255,0.01);">
                <div class="h-36 flex items-center justify-center text-zinc-700 text-xs font-mono uppercase tracking-widest"
                  style="border-bottom: 1px dashed rgba(255,255,255,0.06);">[ À venir ]</div>
                <div class="p-5">
                  <h4 class="font-medium text-sm text-zinc-600">Projet à définir</h4>
                  <p class="text-xs text-zinc-700 mt-1.5 font-light">Placeholder — à remplir</p>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  // Logique du toggle des sous-panneaux
  document.querySelectorAll(".panneau-header").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cibleId = (btn as HTMLElement).dataset.cible!;
      const contenu = document.getElementById(cibleId)!;
      const icone   = btn.querySelector(".panneau-plus") as HTMLElement;
      const isOpen  = btn.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        contenu.style.maxHeight = "0";
        icone.style.transform   = "rotate(0deg)";
        btn.setAttribute("aria-expanded", "false");
      } else {
        contenu.style.maxHeight = contenu.scrollHeight + 200 + "px";
        icone.style.transform   = "rotate(45deg)";
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
