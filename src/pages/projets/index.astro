---
// src/pages/projets/index.astro
import Layout from '../../layouts/Layout.astro';
import CalibrationGrid from '../../components/CalibrationGrid.astro';
import { projects } from '../../data/projects';
import ProjectCard from '../../components/ProjectCard.astro';

const academiques = projects.filter(p => p.group === 'academique');
const persos = projects.filter(p => p.group === 'perso');
const countAca = academiques.length;
const countPerso = persos.length;
---

<Layout title="Projets & Découvertes | Batiste COMET-BARTHE" backHref="/#niveau-1">
  <section class="projects-page__hero">
    <CalibrationGrid />
    <div class="projects-page__hero-inner max-w-6xl mx-auto">
      <span class="eyebrow">Portfolio</span>
      <h1 class="page-title">
        Projets &amp;<br/>
        <span>Découvertes</span>
      </h1>
      <p class="project-hero__description">
        Découvrez l'ensemble de mes travaux académiques et personnels.
      </p>
    </div>
  </section>

  <section class="projects-page__content projects-page__content--museum">
    <div class="projects-page__grid">
      <details class="project-panel project-panel--academic" open>
        <summary class="project-panel__header">
          <span class="eyebrow">Catégorie 01</span>
          <span class="project-panel__title" role="heading" aria-level="3">Académiques</span>
          <span class="project-panel__description">Projets scolaires &amp; universitaires · {countAca} projets</span>
          <span class="project-panel__toggle" aria-hidden="true"></span>
        </summary>

        <div class="project-panel__body" id="panneau-academique">
          <div class="projects-grid">
            {academiques.map(project => <ProjectCard project={project} />)}
          </div>
        </div>
      </details>

      <details class="project-panel project-panel--personal" open>
        <summary class="project-panel__header">
          <span class="eyebrow">Catégorie 02</span>
          <span class="project-panel__title" role="heading" aria-level="3">Expériences Perso.</span>
          <span class="project-panel__description">Projets personnels &amp; explorations · {countPerso} projets</span>
          <span class="project-panel__toggle" aria-hidden="true"></span>
        </summary>

        <div class="project-panel__body" id="panneau-perso">
          <div class="projects-grid">
            {persos.map(project => <ProjectCard project={project} />)}
          </div>
        </div>
      </details>
    </div>
  </section>
</Layout>
