---
// src/pages/projets/index.astro
import Layout from '../../layouts/Layout.astro';
import CalibrationGrid from '../../components/CalibrationGrid.astro';
import { projects } from '../../data/projects';
import ProjectCard from '../../components/ProjectCard.astro';

const academiques = projects.filter(p => p.group === 'academique');
const persos = projects.filter(p => p.group === 'perso');
const countAca = academiques.length;
const countPerso = persos.length;
---

<Layout title="Projets & Découvertes | Batiste COMET-BARTHE" backHref="/#niveau-1">
  <section class="projects-page__hero">
    <CalibrationGrid />
    <div class="projects-page__hero-inner max-w-6xl mx-auto">
      <span class="eyebrow">Portfolio</span>
      <h1 class="page-title">
        Projets &amp;<br/>
        <span>Découvertes</span>
      </h1>
      <p class="project-hero__description">
        Découvrez l'ensemble de mes travaux académiques et personnels.
      </p>
    </div>
  </section>

  <section class="projects-page__content">
    <div class="projects-page__grid">
      <div class="project-panel">
        <div class="project-panel__header">
          <div>
            <span class="eyebrow">Catégorie 01</span>
            <h3>Académiques</h3>
            <p>Projets scolaires &amp; universitaires · {countAca} projets</p>
          </div>
        </div>

        <div class="project-panel__body" id="panneau-academique">
          <div class="projects-grid">
            {academiques.map(project => <ProjectCard project={project} />)}
          </div>
        </div>
      </div>

      <div class="project-panel">
        <div class="project-panel__header">
          <div>
            <span class="eyebrow">Catégorie 02</span>
            <h3>Expériences Perso.</h3>
            <p>Projets personnels &amp; explorations · {countPerso} projets</p>
          </div>
        </div>

        <div class="project-panel__body" id="panneau-perso">
          <div class="projects-grid">
            {persos.map(project => <ProjectCard project={project} />)}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
