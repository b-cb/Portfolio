---
import AnimatedBackground from './AnimatedBackground.astro';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  category: string;
  title: string;
  accent: string;
  description: string;
  tags: string[];
  image?: ImageMetadata;
  video?: string;
  poster?: ImageMetadata;
  imageAlt?: string;
  imageFit?: 'cover' | 'contain';
}

const { category, title, accent, description, tags, image, video, poster, imageAlt = title, imageFit = 'cover' } = Astro.props;
---

<section class="project-hero reveal" data-ambient>
  <AnimatedBackground />
  <div class="project-hero__inner">
    <p class="eyebrow">{category}</p>
    <h1>{title}<br /><span>{accent}</span></h1>
    <p class="project-hero__description">{description}</p>
    <div class="project-tags" aria-label="Technologies utilisées">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
    <ProjectMedia image={image} video={video} poster={poster} alt={imageAlt} className={`project-media project-media--hero project-media--${imageFit}`} />
  </div>
</section>
