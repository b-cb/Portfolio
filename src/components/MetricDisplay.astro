---
interface Metric {
  value: string;
  label: string;
}

interface Props {
  metrics: Metric[];
  lang?: 'fr' | 'en';
}

const { metrics, lang = 'fr' } = Astro.props;
const label = lang === 'en' ? 'Project key figures' : 'Chiffres clés du projet';
---

<dl class="metric-display" aria-label={label}>
  {metrics.map(({ value, label }) => (
    <div class="metric-display__item">
      <dt class="metric-display__value">{value}</dt>
      <dd class="metric-display__label">{label}</dd>
    </div>
  ))}
</dl>

<style>
  .metric-display {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--metric-border, rgb(255 255 255 / 8%));
    background: var(--metric-divider, rgb(255 255 255 / 8%));
  }

  .metric-display__item {
    min-width: 0;
    background: var(--metric-surface, #09090b);
    padding: 1rem 1.1rem;
  }

  .metric-display__value {
    color: var(--metric-value, #e4e4e7);
    font: 500 clamp(1.35rem, 2.5vw, 2rem)/1.1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: -0.06em;
  }

  .metric-display__label {
    margin: 0.55rem 0 0;
    color: var(--metric-label, #71717a);
    font: 0.62rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
