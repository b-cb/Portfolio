---
---

<div class="ambient-layer" aria-hidden="true">
  <canvas class="ambient-canvas"></canvas>
</div>

<script is:inline>
  (() => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = document.querySelector('.ambient-canvas');

    if (prefersReducedMotion || !canvas) return;

    const parent = canvas.closest('.ambient-layer');
    if (!parent || !canvas.getContext) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const pointer = { x: window.innerWidth * 0.5, y: window.innerHeight * 0.5, active: false };

    const exclusionSelector = [
      'nav',
      '.nav-link',
      'a',
      'button',
      '.project-card',
      '.project-media',
      '.project-hero__inner',
      '.project-section',
      '.project-section__content',
      '.panneau-header',
      '.panneau-contenu',
      'h1', 'h2', 'h3', 'p', 'li', 'span',
      '.eyebrow',
      '.project-tags'
    ].join(', ');

    const getExclusionRects = () => {
      const nodes = document.querySelectorAll(exclusionSelector);
      return Array.from(nodes)
        .filter((node) => {
          if (node.closest('.ambient-layer')) return false;
          const rect = node.getBoundingClientRect();
          return rect.width > 0 && rect.height > 0;
        })
        .map((node) => {
          const rect = node.getBoundingClientRect();
          return {
            x: rect.left,
            y: rect.top,
            width: rect.width,
            height: rect.height,
          };
        });
    };

    const inExclusionZone = (x, y, rects) => rects.some((rect) => (
      x >= rect.x && x <= rect.x + rect.width &&
      y >= rect.y && y <= rect.y + rect.height
    ));

    const particles = Array.from({ length: 64 }, () => ({
      x: Math.random(),
      y: Math.random(),
      vx: (Math.random() - 0.5) * 0.18,
      vy: (Math.random() - 0.5) * 0.18,
      radius: Math.random() * 2 + 0.9,
    }));

    const resizeCanvas = () => {
      const rect = parent.getBoundingClientRect();
      const width = Math.max(1, rect.width);
      const height = Math.max(1, rect.height);
      const ratio = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    let rafId = null;

    const draw = () => {
      const rect = parent.getBoundingClientRect();
      const width = Math.max(1, rect.width);
      const height = Math.max(1, rect.height);
      const exclusionRects = getExclusionRects();

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i += 1) {
        const p = particles[i];
        const px = p.x * width;
        const py = p.y * height;

        if (pointer.active) {
          const dx = pointer.x - px;
          const dy = pointer.y - py;
          const dist = Math.hypot(dx, dy) || 1;
          const repel = dist < 180 ? (180 - dist) / 180 : 0;
          p.vx += (dx / dist) * 0.015 * repel;
          p.vy += (dy / dist) * 0.015 * repel;
        }

        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.985;
        p.vy *= 0.985;

        if (p.x < 0 || p.x > 1) p.vx *= -0.9;
        if (p.y < 0 || p.y > 1) p.vy *= -0.9;

        const currentX = p.x * width;
        const currentY = p.y * height;

        if (inExclusionZone(currentX, currentY, exclusionRects)) continue;

        ctx.beginPath();
        ctx.fillStyle = 'rgba(157, 227, 208, 0.72)';
        ctx.arc(currentX, currentY, p.radius, 0, Math.PI * 2);
        ctx.fill();

        for (let j = i + 1; j < particles.length; j += 1) {
          const q = particles[j];
          const qx = q.x * width;
          const qy = q.y * height;
          const distance = Math.hypot(currentX - qx, currentY - qy);

          if (distance < 110) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(157, 227, 208, ${0.14 * (1 - distance / 110)})`;
            ctx.lineWidth = 1;
            ctx.moveTo(currentX, currentY);
            ctx.lineTo(qx, qy);
            ctx.stroke();
          }
        }
      }

      rafId = window.requestAnimationFrame(draw);
    };

    const handlePointer = (event) => {
      const rect = parent.getBoundingClientRect();
      pointer.x = event.clientX - rect.left;
      pointer.y = event.clientY - rect.top;
      pointer.active = true;
    };

    resizeCanvas();
    draw();

    window.addEventListener('resize', resizeCanvas, { passive: true });
    window.addEventListener('pointermove', handlePointer, { passive: true });
    window.addEventListener('pointerleave', () => {
      pointer.active = false;
    }, { passive: true });
    window.addEventListener('beforeunload', () => {
      if (rafId) window.cancelAnimationFrame(rafId);
    }, { once: true });
  })();
</script>
