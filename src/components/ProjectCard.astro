---
import { Image } from 'astro:assets';
import { projects, type Project } from '../data/projects';

interface Props {
  project?: Project;
  placeholder?: boolean;
}

const { project, placeholder = false } = Astro.props;
const projectIndex = project ? Math.max(1, projects.findIndex(({ id }) => id === project.id) + 1) : 0;
---

{placeholder || !project ? (
  <div class="project-card project-card--placeholder" aria-hidden="true">
    <div class="project-card__frame">
      <span class="project-card__corner project-card__corner--tl"></span>
      <span class="project-card__corner project-card__corner--tr"></span>
      <span class="project-card__corner project-card__corner--bl"></span>
      <span class="project-card__corner project-card__corner--br"></span>
    </div>
    <div class="project-card__media"></div>
    <div class="project-card__content">
      <span class="project-card__code">PROJECT_--</span>
      <h3>Projet à définir</h3>
    </div>
  </div>
) : (
  <a href={project.href} class="project-card group">
    <div class="project-card__frame" aria-hidden="true">
      <span class="project-card__corner project-card__corner--tl"></span>
      <span class="project-card__corner project-card__corner--tr"></span>
      <span class="project-card__corner project-card__corner--bl"></span>
      <span class="project-card__corner project-card__corner--br"></span>
    </div>

    <div class="project-card__media">
      {project.image ? (
        <Image src={project.image} alt={`${project.title}${project.accent ? ` ${project.accent}` : ''}`} class="project-card__image" />
      ) : (
        <span class="project-card__image-placeholder">IMAGE / NON DISPONIBLE</span>
      )}
      <span class="project-card__index" aria-hidden="true">DET. {String(projectIndex).padStart(2, '0')}</span>
    </div>

    <div class="project-card__content">
      <div class="project-card__meta">
        <span class="project-card__code">PROJET_{String(projectIndex).padStart(2, '0')}</span>
        <span>{project.categoryText}</span>
      </div>
      <h3>{project.title}{project.accent && ` ${project.accent}`}</h3>
      <p>{project.description}</p>
      <ul class="project-card__tags" aria-label="Technologies utilisées">
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </a>
)}
