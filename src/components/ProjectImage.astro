---
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  height?: 'medium' | 'large';
  fit?: 'cover' | 'contain';
}

const { src, alt = '', height = 'medium', fit = 'cover' } = Astro.props;
---

{src ? (
  <figure class={`project-media project-media--${height} reveal`}>
    <Image src={src} alt={alt} class={`project-media__image project-media__image--${fit}`} />
  </figure>
) : (
  <div class={`project-media project-media--${height} project-media--empty reveal`}>
    <span>Image secondaire — optionnel</span>
  </div>
)}
